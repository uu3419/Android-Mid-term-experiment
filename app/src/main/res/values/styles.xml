<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- UI 美化：统一主题配色（深蓝灰 ActionBar + 青色强调色 + 浅灰页面底色）
         注意：NotesList 继承自平台的 ListActivity，不是 AppCompatActivity，
         因此必须使用平台 Material 主题，否则 ActionBar（含菜单入口）不会显示。 -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:actionBarStyle">@style/AppActionBar</item>
    </style>

    <!-- UI 美化：ActionBar 显示应用 Logo + 标题 -->
    <style name="AppActionBar" parent="@android:style/Widget.Material.ActionBar.Solid">
        <item name="android:displayOptions">showHome|useLogo|showTitle</item>
    </style>
</resources>
